# Copy this file to .env and fill in your own values

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/mental-health-journal
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mental-health-journal
MONGO_URI=mongodb://127.0.0.1:27017/mental-health-journal

# Port the Express server runs on
PORT=5000

# For step 1 we are running single-user (no login yet), this id
# is used as a stand-in "current user" for all journal entries.
DEFAULT_USER_ID=demo-user
